{
  "name": "academy",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node -e \"if (require('fs').existsSync('src/tools')) { console.log('Tools folder excluded from build'); }\" && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "tools:merge-cards": "node src/tools/merge-cards.js",
    "images": "node src/tools/convert-images.js",
    "tools:all": "npm run tools:merge-cards && npm run tools:convert-images"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-svelte": "^3.5.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.28.1",
    "svelte-check": "^4.1.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.2",
    "@mistralai/mistralai": "^1.7.1",
    "@xenova/transformers": "^2.17.2",
    "dexie": "^4.0.11",
    "sharp": "^0.34.3"
  }
}
